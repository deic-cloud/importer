<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
	<id>importer</id>
	<name>Import</name>
	<summary>Import files from HTTP, FTP, S3 and WebDAV sources</summary>
	<description>Queue downloads from remote HTTP/HTTPS URLs, FTP servers, S3-compatible object stores, and WebDAV servers directly into your Nextcloud files.</description>
	<version>1.0.0</version>
	<licence>agpl</licence>
	<author mail="fror@dtu.dk">Frederik Orellana, DTU</author>
	<namespace>Importer</namespace>
	<bootstrap>OCA\Importer\AppInfo\Application</bootstrap>
	<category>files</category>
	<dependencies>
		<nextcloud min-version="34" max-version="35"/>
		<php min-version="8.2"/>
	</dependencies>
	<navigations>
		<navigation>
			<name>Import</name>
			<route>importer.page.index</route>
			<icon>app.svg</icon>
			<order>30</order>
		</navigation>
	</navigations>
	<settings>
		<personal>OCA\Importer\Settings\PersonalSettings</personal>
	</settings>
</info>
